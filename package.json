{
  "name": "epiclint",
  "version": "0.1.1",
  "description": "Unofficial TypeScript Coding Style based on Epitech C Coding Style.",
  "type": "module",
  "bin": {
    "epiclint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/rules.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
